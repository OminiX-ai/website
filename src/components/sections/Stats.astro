---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

const stats = [
  {
    value: '45',
    label: 'tok/s LLM on M3',
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 4v8l6-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8 28l6-12 5 8 4-6 9 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4 34h32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
    </svg>`,
    color: 'text-accent',
  },
  {
    value: '18x',
    label: 'real-time ASR',
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 20h4l3-8 4 16 4-12 3 8 4-4h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
    color: 'text-heading',
  },
  {
    value: '14',
    label: 'model crates',
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="6" y="6" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2"/>
      <rect x="22" y="6" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2"/>
      <rect x="6" y="22" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2"/>
      <rect x="22" y="22" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2"/>
    </svg>`,
    color: 'text-accent',
  },
  {
    value: '0',
    label: 'Python deps',
    icon: `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 10l-8 10 8 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M28 10l8 10-8 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M23 6l-6 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
    </svg>`,
    color: 'text-accent',
  },
];
---

<Section background="secondary" padY="md">
  <Container>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 md:gap-6">
      {stats.map((stat) => (
        <div class="flex flex-col items-center gap-3 text-center reveal">
          <div class:list={['h-10 w-10', stat.color]} set:html={stat.icon} />
          <span class="font-mono text-[32px] leading-none tracking-[-0.02em] text-text-bright md:text-[40px]">
            {stat.value}
          </span>
          <span class="font-mono text-[15px] uppercase tracking-[0.08em] text-neutral-2">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </Container>
</Section>
