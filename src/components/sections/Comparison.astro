---
import SvgSection from 'components/ui/SvgSection.astro';

const rows = [
  { dim: 'Language', ominix: 'Pure Rust', ollama: 'Go + C++', lmstudio: 'Electron + C++' },
  { dim: 'Multimodal', ominix: 'LLM+TTS+ASR+Image', ollama: 'LLM only', lmstudio: 'LLM only' },
  { dim: 'Voice Cloning', ominix: 'Yes', ollama: 'No', lmstudio: 'No' },
  { dim: 'Image Gen', ominix: 'FLUX, Z-Image', ollama: 'No', lmstudio: 'No' },
  { dim: 'OpenAI API', ominix: 'Full compatible', ollama: 'Partial', lmstudio: 'Partial' },
  { dim: 'Apple Silicon', ominix: 'Native MLX', ollama: 'llama.cpp', lmstudio: 'llama.cpp' },
  { dim: 'Ascend NPU', ominix: 'Yes', ollama: 'No', lmstudio: 'No' },
  { dim: 'Python Deps', ominix: 'Zero', ollama: 'Zero', lmstudio: 'Some' },
];
---

<SvgSection id="comparison">
  <div class="glass-panel mb-8">
    <p class="font-mono text-[16px] uppercase tracking-[0.08em] text-neutral-2">Comparison</p>
    <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
      OminiX vs Ollama vs LM Studio
    </h2>
    <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-neutral-2">
      OminiX is a full multimodal AI platform, not just an LLM runner.
      Voice cloning, image generation, and ASR set it apart.
    </p>
  </div>

  <div class="glass-panel overflow-x-auto">
    <table class="w-full border-collapse text-[15px]">
      <thead>
        <tr class="border-b border-white/10">
          <th class="px-3 py-3 text-left font-mono text-[15px] uppercase tracking-[0.08em] text-neutral-1">Dimension</th>
          <th class="px-3 py-3 text-left font-mono text-[15px] uppercase tracking-[0.08em] text-accent">OminiX</th>
          <th class="px-3 py-3 text-left font-mono text-[15px] uppercase tracking-[0.08em] text-neutral-2">Ollama</th>
          <th class="px-3 py-3 text-left font-mono text-[15px] uppercase tracking-[0.08em] text-neutral-2">LM Studio</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-white/5 transition-colors duration-200 hover:bg-white/5">
            <td class="px-3 py-2.5 font-mono text-[16px] text-neutral-2">{row.dim}</td>
            <td class="px-3 py-2.5 text-text-bright">{row.ominix}</td>
            <td class="px-3 py-2.5 text-neutral-2">{row.ollama}</td>
            <td class="px-3 py-2.5 text-neutral-2">{row.lmstudio}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</SvgSection>
