---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

const pipelines = [
  { name: 'Chat / LLM' },
  { name: 'Speech Recognition' },
  { name: 'Text-to-Speech' },
  { name: 'Voice Cloning' },
  { name: 'Image Generation' },
  { name: 'OCR' },
];
---

<Section padY="lg">
  <Container>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[16px] uppercase tracking-[0.08em] text-neutral-2">Multimodal Pipelines</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] text-text-bright md:text-[36px] lg:text-[48px]">
        Six AI pipelines in one server
      </h2>
      <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-neutral-2">
        All pipelines share the same API server and model cache.
        Load models on demand and switch between tasks seamlessly.
      </p>
    </div>

    <div class="grid grid-cols-3 gap-4 md:grid-cols-6" data-animate>
      {pipelines.map((item) => (
        <div class="group flex flex-col items-center gap-2 rounded-sm border border-surface-3 bg-surface-1 px-3 py-4 transition-colors duration-300 hover:border-neutral-1">
          <span class="font-mono text-[15px] uppercase tracking-[0.08em] text-neutral-2 transition-colors duration-300 group-hover:text-accent">
            {item.name}
          </span>
        </div>
      ))}
    </div>
  </Container>
</Section>
